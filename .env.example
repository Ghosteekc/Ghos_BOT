# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# Clash Royale API key from https://developer.clashroyale.com
# Whitelist: только IP вашего VPS-прокси (если используете прокси)
CLASH_ROYALE_API_KEY=your_clash_royale_api_key

# Прямой доступ (локально) или VPS-прокси (статический IP на VPS)
# Локально: https://api.clashroyale.com/v1
# VPS:      http://YOUR_VPS_IP/v1  (см. scripts/cr-proxy/README.md)
CLASH_ROYALE_API_BASE=https://api.clashroyale.com/v1

# Секрет для VPS nginx (тот же, что в cr-proxy.conf). Пусто — если API напрямую.
CLASH_ROYALE_PROXY_SECRET=

# Clash Royale HTTP client
CR_API_TIMEOUT_SEC=15
CR_API_RETRY_MAX=3
CR_API_RETRY_BASE_DELAY_SEC=1.0

# Database URL
# Local: SQLite file is fine
DATABASE_URL=sqlite+aiosqlite:///./cr_bot.db
#
# Railway (REQUIRED for persistent accounts): add Postgres plugin, then either
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# or paste the Postgres URL. App auto-converts postgres:// → postgresql+asyncpg://
# Without Postgres (or a Volume mounted on the .db path), every redeploy wipes users.

# Subscription settings
TRIAL_DAYS=30
SUBSCRIPTION_PRICE_STARS=0

# Mini App URL on Vercel (HTTPS, for BotFather Menu Button and WEBAPP_URL)
WEBAPP_URL=https://your-project.vercel.app

# Support Telegram username (without @)
SUPPORT_USERNAME=your_support_username

# Bot public @username without @ — referral links: https://t.me/<BOT_USERNAME>?start=ref_<id>
# If empty, resolved automatically via getMe on startup.
BOT_USERNAME=

# Frontend API base URL for Vite build (URL localtunnel / VPS, см. scripts/localtunnel/)
# VITE_API_URL=http://localhost:8080

# API server (FastAPI)
API_HOST=0.0.0.0
API_PORT=8080
# Railway: platform injects PORT — Settings also reads PORT (no need to set API_PORT there).

# Localtunnel (local/dev only). On Railway auto-disabled unless you set TUNNEL_AUTO_START=true.
TUNNEL_AUTO_START=true
TUNNEL_SUBDOMAIN=ghosteekcr
# TUNNEL_SKIP_LOCA_LT_CHECK=false

# --- Railway checklist ---
# Start: python -m bot.main  (see Procfile / railway.toml)
# Required vars: BOT_TOKEN, CLASH_ROYALE_API_KEY, WEBAPP_URL (Vercel HTTPS)
# Recommended: TUNNEL_AUTO_START=false (auto on Railway), DATABASE_URL + volume or Postgres
# Optional AI: LLM_API_KEY, LLM_BASE_URL, LLM_MODEL (or GHOSTEEK_AI_BACKEND=template)
# Do NOT commit .env, *.db, data/*.png, cloudflared logs

# Optional: admin Telegram IDs — full Pro access + /admin_sub and /sync_now (comma-separated)
ADMIN_TELEGRAM_ID=123456789
ADMIN_TELEGRAM_IDS=123456789,987654321

META_REFRESH_HOURS=6
META_TOP_PLAYERS_SCAN=20
# Optional comma-separated player tags for meta fallback
META_SEED_TAGS=
# Persistent league/trophy meta collector (not on each Meta tab open)
META_COLLECTOR_INTERVAL_MINUTES=180
META_COLLECTOR_STARTUP_DELAY_SEC=90
META_COLLECTOR_PLAYERS=40
META_COLLECTOR_CONCURRENCY=4
META_MIN_GAMES=5
META_TROPHY_MIN=10000
META_HISTORY_DAYS=14
META_RANKING_LIMIT=16

# Background battle sync
SYNC_INTERVAL_MINUTES=60
SYNC_CR_API_TIMEOUT_SEC=20
SYNC_SHUTDOWN_TIMEOUT_SEC=30

# Telegram Mini App initData TTL (seconds)
INIT_DATA_MAX_AGE_SECONDS=86400
INIT_DATA_CLOCK_SKEW_SECONDS=60

# Ghosteek AI — response generator backend (qwen | groq | ollama | template)
# Default stays cloud-safe (qwen). Local Ollama is opt-in via ENV only.
# On LLM errors the service falls back to template automatically.
GHOSTEEK_AI_BACKEND=qwen
# auto | agent | planner
# auto: agent for cloud when tools supported; planner-first for local qwen3:8b
GHOSTEEK_AI_MODE=auto

# OpenAI-compatible LLM (Qwen / Groq / DashScope compatible-mode)
# Cloud Qwen (default when GHOSTEEK_AI_BACKEND=qwen):
#   LLM_API_KEY / LLM_BASE_URL / LLM_MODEL below
# Groq example:
#   GHOSTEEK_AI_BACKEND=groq
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=qwen/qwen3.6-27b
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen3-235b-a22b-thinking-2507
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3

# Local Ollama backend (native /api/chat) — independent from LLM_* cloud settings.
# To enable local Qwen3 8B set BOTH:
#   GHOSTEEK_AI_BACKEND=ollama
#   GHOSTEEK_AI_MODE=planner   # or auto (qwen3:8b still forces planner-first)
# Recommended local values (do not raise for "quality"):
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.4
OLLAMA_NUM_PREDICT=220
OLLAMA_NUM_CTX=2048
# Top-level /api/chat think (not options.think) — disables Qwen3 thinking generation
OLLAMA_THINK=false
# Keep false for qwen3:8b. true does NOT unlock Agent Mode for this model (warning only).
OLLAMA_ENABLE_TOOLS=false

# Replay analysis (Stage 5 full recognition)
# One heavy vision job at a time — do not raise without measuring CPU/RAM.
REPLAY_MAX_CONCURRENT_JOBS=1
# Baseline sampling for calm segments (2–4)
REPLAY_ANALYSIS_FPS=3
# Densify around visual changes (6–10)
REPLAY_EVENT_FPS=8
REPLAY_MAX_FRAMES=96
REPLAY_FRAME_TIMEOUT_SECONDS=120
# 1 = adaptive FPS densify; 0 = legacy uniform 16–24 frames
REPLAY_ADAPTIVE_SAMPLING=1
# Stage 5 vision event analyzer (disabled by default — enable after Ollama vision model is ready)
REPLAY_VISION_ENABLED=0
REPLAY_VISION_MAX_FRAMES_PER_JOB=12
REPLAY_VISION_MIN_FRAME_GAP_SECONDS=1.0
REPLAY_VISION_TIMEOUT_SECONDS=90
REPLAY_EVENT_CONFIDENCE_THRESHOLD=0.90
REPLAY_VISION_MODEL=qwen3.5:9b
# Stage 6: evidence frames for confirmed vision events
REPLAY_EVIDENCE_ENABLED=1
REPLAY_EVIDENCE_CLIP_ENABLED=0
REPLAY_EVIDENCE_PRE_SECONDS=1.5
REPLAY_EVIDENCE_POST_SECONDS=1.5
REPLAY_EVIDENCE_MAX_MOMENTS=6
# Stage 7: grounded moment explanation (Qwen wording only; facts remain SoT)
REPLAY_MOMENT_RENDER_ENABLED=1
REPLAY_MOMENT_MAX=6
REPLAY_MOMENT_QWEN_TIMEOUT_SECONDS=30
